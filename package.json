{
  "name": "whatsmyagentdoing",
  "version": "0.3.2",
  "description": "Hurly ops office: Paperclip/Hurly bot avatars in the whatsmyagentdoing isometric office, plus local Claude/Codex/Gemini/OMP sessions.",
  "bin": {
    "whatsmyagentdoing": "bin/cli.js",
    "hurly-ops-office": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "assets",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agents",
    "dashboard",
    "monitor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HurlyDesousa/whatsmyagentdoing.git"
  },
  "homepage": "https://github.com/HurlyDesousa/whatsmyagentdoing#readme",
  "bugs": {
    "url": "https://github.com/HurlyDesousa/whatsmyagentdoing/issues"
  },
  "author": "cheoyu",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "three": "^0.186.1"
  },
  "scripts": {
    "build": "esbuild web/office3d.js --bundle --format=esm --minify --target=es2020 --outfile=public/office3d.js --legal-comments=eof",
    "start": "node bin/cli.js",
    "test:ui": "node tests/ui.cjs",
    "test:watcher": "node --test tests/watcher.cjs tests/omp.cjs tests/paperclip.cjs",
    "test:server": "node --test tests/server.cjs",
    "test:paperclip": "node --test tests/paperclip.cjs"
  }
}
